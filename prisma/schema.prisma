generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-row table holding everything the dashboard can change about the storefront.
model Setting {
  id                    Int     @id @default(1)
  storeName             String  @default("Wallsy")
  tagline               String  @default("আপনার দেয়ালে শিল্পের ছোঁয়া")
  announcement          String  @default("সারা বাংলাদেশে ক্যাশ অন ডেলিভারি · ৳২,৫০০+ অর্ডারে ফ্রি ডেলিভারি")
  announcementEnabled   Boolean @default(true)
  heroEyebrow           String  @default("নতুন কালেকশন এসেছে")
  heroTitle             String  @default("আপনার দেয়াল হোক আপনার গল্প")
  heroSubtitle          String  @default("প্রিমিয়াম কোয়ালিটির ওয়াল আর্ট, ফ্রেমসহ রেডি টু হ্যাং। সারা বাংলাদেশে ক্যাশ অন ডেলিভারি।")
  heroCta               String  @default("এখনই কিনুন")
  heroImage             String  @default("/art/sunset-dunes.svg")
  currency              String  @default("৳")
  freeShippingThreshold Int     @default(250000)
  shippingFee           Int     @default(7000) // inside Dhaka
  shippingFeeOutside    Int     @default(13000) // outside Dhaka
  framePrice            Int     @default(90000)
  frameCost             Int     @default(0) // what one frame costs you, for profit tracking
  newsletterTitle       String  @default("প্রথম অর্ডারে ১০% ছাড় পান")
  newsletterText        String  @default("নতুন কালেকশন, ডেকোরেশন টিপস আর এক্সক্লুসিভ অফার সবার আগে পেতে যোগ দিন।")
  newsletterCode        String  @default("WELCOME10")
  contactEmail          String  @default("hello@wallsy.shop")
  contactPhone          String  @default("+880 1839-295114")
  // Digits only with country code, used for wa.me links
  whatsappNumber        String  @default("8801839295114")
  instagram             String  @default("")
  // Storefront text editable from the dashboard. Empty means "use the built-in default".
  faqJson               String  @default("")
  trustJson             String  @default("")
  deliveryText          String  @default("")
  aboutTitle            String  @default("")
  aboutText             String  @default("")
  aboutImage            String  @default("")
  returnText            String  @default("")
  facebook              String  @default("")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  image       String    @default("")
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  artist         String      @default("")
  description    String      @default("")
  price          Int
  compareAtPrice Int?
  costPrice      Int         @default(0) // what one print costs you (used when there are no sizes)
  images         String      @default("[]") // JSON array of image URLs
  stock          Int         @default(0)
  featured       Boolean     @default(false)
  bestseller     Boolean     @default(false)
  active         Boolean     @default(true)
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       Variant[]
  reviews        Review[]
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// Size options. A product without variants sells at its base price.
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  cost      Int     @default(0) // what this size costs you
  sortOrder Int     @default(0)
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  number        Int         @unique
  email         String      @default("")
  name          String
  phone         String      @default("")
  address       String
  city          String
  zip           String      @default("")
  country       String      @default("Bangladesh")
  deliveryArea  String      @default("inside") // inside | outside Dhaka
  note          String      @default("")
  subtotal      Int
  discount      Int         @default(0)
  shipping      Int
  total         Int
  discountCode  String?
  paymentMethod String      @default("cod")
  status        String      @default("pending") // pending | processing | shipped | delivered | cancelled
  // When the order was marked delivered: cash-on-delivery income counts from this date.
  deliveredAt   DateTime?
  source        String      @default("website") // website | whatsapp | phone | facebook | instagram | other
  courier       String      @default("")
  trackingCode  String      @default("")
  adminNote     String      @default("")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  variant   String   @default("")
  frame     String   @default("")
  image     String   @default("")
  unitPrice Int
  unitCost  Int      @default(0) // cost to the store at the time of the order, for profit
  quantity  Int
}

model DiscountCode {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   @default("percent") // percent | fixed
  value       Int // percent (e.g. 10) or minor currency units (e.g. 500 = 5.00)
  minSubtotal Int      @default(0)
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Money in or out that isn't a store order (printing costs, ads, rent, offline sales...).
model FinanceEntry {
  id        String   @id @default(cuid())
  type      String // income | expense
  category  String
  note      String   @default("")
  amount    Int // minor currency units (paisa)
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
}

// Uploaded images (product photos, collection covers, hero), served from /api/img/[id].
// Kept in the database so uploads work on Vercel without extra storage setup.
model Image {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  size        Int
  createdAt   DateTime @default(now())
}

// Journal (blog) posts written in the dashboard.
model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String   @default("")
  body      String   @default("")
  cover     String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

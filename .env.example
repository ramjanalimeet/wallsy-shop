# Postgres connection string. On Vercel, add a Neon (or Supabase) database from the
# Storage tab and this is filled in for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wallsy"

# Admin dashboard login (/admin)
ADMIN_PASSWORD="change-me"
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SECRET="replace-with-a-long-random-string"

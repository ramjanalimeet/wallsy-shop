# Database. SQLite works out of the box for local development.
# For production (Vercel, etc.) use Postgres and change `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Admin dashboard login (/admin)
ADMIN_PASSWORD="change-me"
# Long random string used to sign the admin session cookie
ADMIN_SECRET="replace-with-a-long-random-string"

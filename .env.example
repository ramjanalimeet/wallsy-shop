# Postgres connection string. On Vercel, add a Neon database from the Storage tab and
# this is set for you. Tables and the starter catalog are created on the first visit.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wallsy"

# Dashboard sign-in at /admin. ADMIN_EMAIL is optional; without it only the password is asked.
ADMIN_EMAIL=""
ADMIN_PASSWORD="change-me"
